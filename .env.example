# ===== 对话模型 =====
# auto: 有 DEEPSEEK_API_KEY 用 DeepSeek，有 DASHSCOPE_API_KEY 用百炼，都没有则 Mock
LLM_PROVIDER=auto

# DeepSeek（OpenAI 兼容；不支持 embedding / rerank）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# 阿里云百炼（可选：同时提供 embedding 与 rerank）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_GENERATION_MODEL=qwen-plus
QWEN_FAST_MODEL=qwen-turbo
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_RERANK_MODEL=gte-rerank-v2

# ===== 向量 / 精排后端（与对话模型解耦）=====
# embedding: auto | fastembed | dashscope | hash
EMBEDDING_BACKEND=auto
FASTEMBED_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# rerank: auto | llm | lexical | dashscope | fastembed
RERANK_BACKEND=auto
FASTEMBED_RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
FASTEMBED_CACHE_DIR=
# 国内/受限网络下模型下载会 SSL EOF，设成镜像站
# HF_ENDPOINT=https://hf-mirror.com

EMBED_DIM=1024

# auto: 有 Key 用真实模型，无 Key 用 Mock；也可强制 1/0
MOCK_MODE=auto

# ===== 检索参数 =====
PARENT_SIZE=900
CHILD_SIZE=220
PARENT_OVERLAP=120
CHILD_OVERLAP=40
RETRIEVE_TOP_K=10
RERANK_TOP_N=3
USE_HYBRID=true
USE_RERANK=true
CONTEXT_MAX_CHARS=3200
RRF_K=60
MIN_RERANK_SCORE=0.05
MAX_REWRITE_RETRIES=1
GRADE_HIGH_SCORE=0.50
GRADE_LOW_SCORE=0.12

# 字段级脱敏：没有 pii 权限的角色看到的手机号/身份证/银行卡会被打码
MASK_PII=true

# 评测/批处理的成本上限（人民币）。超过后立即中止，0 表示不限制
COST_BUDGET_CNY=0

# ===== 上下文管理 =====
MAX_HISTORY_TURNS=4
SUMMARY_TRIGGER_TURNS=6

# ===== 向量库 =====
# auto: 装了 qdrant-client 就用 Qdrant，否则回落本地 numpy 实现
VECTOR_BACKEND=auto
# 不填则使用 Qdrant 嵌入式模式（data/index/qdrant）；填了就连服务端
QDRANT_URL=
QDRANT_API_KEY=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
